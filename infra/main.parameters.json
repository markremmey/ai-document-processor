{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
      "environmentName": {
        "value": "${AZURE_ENV_NAME}"
      },
      "location": {
        "value": "${AZURE_LOCATION}"
      },
      "principalId": {
        "value": "${AZURE_PRINCIPAL_ID}"
      },
      "resourceGroup": {
        "value": "${AZURE_RESOURCE_GROUP}"
      },
      "networkIsolation": {
        "value": "${AZURE_NETWORK_ISOLATION}"
      },
      "ai_vision_enabled": {
        "value": "${AI_VISION_ENABLED}"
      },
      "multimodal": {
        "value": "${AOAI_MULTI_MODAL}"
      },
      "deploymentTags":{
        "value": {}
      },
      "deployVM": {
        "value": "${AZURE_DEPLOY_VM}"
      },
      "deployVPN": {
        "value": "${AZURE_DEPLOY_VPN}"
      },
      "aoaiLocation": {
        "value": "${AOAI_LOCATION}"
      }
    }
}